<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_capex_line_details" model="ir.ui.view">
    <field name="name">capex.budget.line.details</field>
    <field name="model">capex.budget.line</field>
    <field name="arch" type="xml">
      <form string="Suivi CAPEX" create="0" edit="0" delete="0" class="o_capex_details">
        <field name="currency_id" invisible="True"/>
        <div class="o_capex_details_heading">
          <span class="text-muted">SUIVI DE L’INVESTISSEMENT</span>
          <h2><field name="description" readonly="1"/></h2>
        </div>
        <div class="o_capex_details_cards">
          <div class="o_capex_detail_card"><span>Budget annuel</span><field name="total" readonly="1"/></div>
          <div class="o_capex_detail_card"><span>Montant approuvé</span><field name="approved_amount" readonly="1"/></div>
          <div class="o_capex_detail_card"><span>Reste disponible</span><field name="remaining_amount" readonly="1" decoration-danger="remaining_amount &lt; 0" decoration-success="remaining_amount &gt;= 0"/></div>
        </div>
        <div class="o_capex_pending_note">
          <span>Montant en attente : </span><field name="pending_amount" readonly="1"/>
          <span> — Non déduit du budget</span>
        </div>
        <p class="text-muted">Les listes de DA affichent les demandes accessibles selon vos droits. Les indicateurs couvrent toutes les DA liées à cette ligne.</p>
        <notebook>
          <page string="DA approuvées" name="approved_requests">
            <field name="approved_request_ids" readonly="1" nolabel="1">
              <list create="0" edit="0" delete="0">
                <field name="name" string="Référence DA"/>
                <field name="initiator_id" string="Demandeur" options="{'no_open': True}"/>
                <field name="description"/>
                <field name="date_created"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="devis_retenu" string="Montant"/>
              </list>
            </field>
          </page>
          <page string="DA en attente" name="pending_requests">
            <field name="pending_request_ids" readonly="1" nolabel="1">
              <list create="0" edit="0" delete="0">
                <field name="name" string="Référence DA"/>
                <field name="initiator_id" string="Demandeur" options="{'no_open': True}"/>
                <field name="description"/>
                <field name="date_created"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="devis_retenu" string="Montant"/>
              </list>
            </field>
          </page>
          <page string="Historique" name="consumption_history">
            <field name="history_ids" readonly="1" nolabel="1" options="{'no_open': True}">
              <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="request_name"/>
                <field name="description"/>
                <field name="requester_id" options="{'no_open': True}"/>
                <field name="operation"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount"/>
                <field name="balance_before"/>
                <field name="balance_after"/>
              </list>
            </field>
          </page>
        </notebook>
        <footer><button string="Fermer" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>
  <record id="view_capex_budget_list" model="ir.ui.view">
    <field name="name">capex.budget.list</field>
    <field name="model">capex.budget</field>
    <field name="arch" type="xml">
      <list string="CAPEX annuels" class="o_ar_modern_list">
        <field name="name"/>
        <field name="year" widget="integer" options="{'format': False}"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="total"/>
      </list>
    </field>
  </record>
  <record id="view_capex_budget_form" model="ir.ui.view">
    <field name="name">capex.budget.form</field>
    <field name="model">capex.budget</field>
    <field name="arch" type="xml">
      <form string="CAPEX annuel" class="o_capex_full_width">
        <sheet>
          <field name="currency_id" invisible="True"/>
          <div class="o_capex_header">
            <div class="o_capex_heading">
              <span class="o_capex_eyebrow">PLAN D’INVESTISSEMENT</span>
              <h1><field name="name"/></h1>
              <p>Planifiez les investissements de votre équipe, mois par mois.</p>
              <div class="o_capex_metadata">
                <div><label for="year"/><field name="year" options="{'format': False}" readonly="line_ids"/></div>
                <div groups="base.group_multi_company"><label for="company_id"/><field name="company_id" readonly="line_ids"/></div>
              </div>
            </div>
            <div class="o_capex_kpis">
              <div class="o_capex_budget_card">
                <span class="o_capex_eyebrow">BUDGET ANNUEL</span>
                <field name="total" class="o_capex_budget_amount"/>
                <span class="o_capex_budget_hint">Total des prévisions sur les 12 mois</span>
              </div>
              <div class="o_capex_budget_card o_capex_remaining_card">
                <span class="o_capex_eyebrow">TOTAL DU RESTE DISPONIBLE</span>
                <field name="total_remaining_amount" class="o_capex_budget_amount"/>
                <span class="o_capex_budget_hint">Budget annuel moins les demandes approuvées</span>
              </div>
              <div class="o_capex_budget_card o_capex_approved_card">
                <span class="o_capex_eyebrow">TOTAL DES DA APPROUVÉES</span>
                <field name="total_approved_amount" class="o_capex_budget_amount"/>
                <span class="o_capex_budget_hint">Montant cumulé des demandes approuvées</span>
              </div>
              <div class="o_capex_budget_card o_capex_pending_card">
                <span class="o_capex_eyebrow">TOTAL DES DA EN ATTENTE</span>
                <field name="total_pending_amount" class="o_capex_budget_amount"/>
                <span class="o_capex_budget_hint">Montant cumulé des demandes en attente de validation</span>
              </div>
            </div>
          </div>
          <div class="o_capex_section_heading">
            <h2>Investissements prévus</h2>
            <p>Une ligne par investissement, une contribution par utilisateur.</p>
          </div>
          <div class="o_capex_table">
          <field name="line_ids">
            <list editable="bottom" string="Prévisions mensuelles">
              <field name="can_edit" column_invisible="True"/>
              <field name="currency_id" column_invisible="True"/>
              <field name="user_id" options="{'no_open': True}"/>
              <field name="description" readonly="not can_edit"/>
              <field name="jan" sum="Total janvier" readonly="not can_edit"/>
              <field name="feb" sum="Total février" readonly="not can_edit"/>
              <field name="mar" sum="Total mars" readonly="not can_edit"/>
              <field name="apr" sum="Total avril" readonly="not can_edit"/>
              <field name="may" sum="Total mai" readonly="not can_edit"/>
              <field name="jun" sum="Total juin" readonly="not can_edit"/>
              <field name="jul" sum="Total juillet" readonly="not can_edit"/>
              <field name="aug" sum="Total août" readonly="not can_edit"/>
              <field name="sep" sum="Total septembre" readonly="not can_edit"/>
              <field name="oct" sum="Total octobre" readonly="not can_edit"/>
              <field name="nov" sum="Total novembre" readonly="not can_edit"/>
              <field name="dec" sum="Total décembre" readonly="not can_edit"/>
              <field name="total" sum="Total annuel"/>
              <field name="approved_amount" string="Total des DA approuvées" sum="Total des DA approuvées" readonly="1"/>
              <field name="pending_amount" string="Total des DA en attente" sum="Total des DA en attente" readonly="1"/>
              <button name="action_consumption_details" type="object" string="Voir détails" icon="fa-external-link" class="btn-link"/>
            </list>
          </field>
          </div>
          <div class="o_capex_section_heading">
            <h2>Répartition mensuelle</h2>
            <p>Montants cumulés de toutes les lignes du CAPEX.</p>
          </div>
          <div class="o_capex_months">
            <div class="o_capex_month"><span>Janvier</span><small>Budget prévu</small><field name="total_jan"/><small>Reste disponible</small><field name="remaining_jan" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Février</span><small>Budget prévu</small><field name="total_feb"/><small>Reste disponible</small><field name="remaining_feb" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Mars</span><small>Budget prévu</small><field name="total_mar"/><small>Reste disponible</small><field name="remaining_mar" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Avril</span><small>Budget prévu</small><field name="total_apr"/><small>Reste disponible</small><field name="remaining_apr" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Mai</span><small>Budget prévu</small><field name="total_may"/><small>Reste disponible</small><field name="remaining_may" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Juin</span><small>Budget prévu</small><field name="total_jun"/><small>Reste disponible</small><field name="remaining_jun" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Juillet</span><small>Budget prévu</small><field name="total_jul"/><small>Reste disponible</small><field name="remaining_jul" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Août</span><small>Budget prévu</small><field name="total_aug"/><small>Reste disponible</small><field name="remaining_aug" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Septembre</span><small>Budget prévu</small><field name="total_sep"/><small>Reste disponible</small><field name="remaining_sep" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Octobre</span><small>Budget prévu</small><field name="total_oct"/><small>Reste disponible</small><field name="remaining_oct" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Novembre</span><small>Budget prévu</small><field name="total_nov"/><small>Reste disponible</small><field name="remaining_nov" class="o_capex_month_remaining"/></div>
            <div class="o_capex_month"><span>Décembre</span><small>Budget prévu</small><field name="total_dec"/><small>Reste disponible</small><field name="remaining_dec" class="o_capex_month_remaining"/></div>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_capex_consumption_history_list" model="ir.ui.view">
    <field name="name">capex.consumption.history.list</field>
    <field name="model">capex.consumption.history</field>
    <field name="arch" type="xml">
      <list string="Historique des déductions" create="0" edit="0" delete="0" decoration-success="operation == 'reversal'">
        <field name="date"/>
        <field name="request_name"/>
        <field name="description"/>
        <field name="requester_id" options="{'no_open': True}"/>
        <field name="operation"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="amount"/>
        <field name="balance_before"/>
        <field name="balance_after"/>
      </list>
    </field>
  </record>
  <record id="action_purchase_request_capex" model="ir.actions.act_window">
    <field name="name">CAPEX</field>
    <field name="res_model">capex.budget</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Créez le CAPEX de l'année</p>
      <p>Chaque utilisateur peut ajouter ses lignes et répartir les montants prévus sur les 12 mois.</p>
    </field>
  </record>
  <menuitem id="menu_purchase_request_capex" name="CAPEX" parent="menu_purchase_request_root"
            action="action_purchase_request_capex" sequence="2" groups="demande_d_achat.groupe_capex"/>
</odoo>
